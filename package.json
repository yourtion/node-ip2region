{
  "name": "ip2region",
  "version": "3.0.0",
  "description": "Extensible native Node, Bun and Deno IP lookup with bundled ip2region data",
  "keywords": [
    "bun",
    "deno",
    "geoip",
    "ip",
    "ip2region",
    "ipv4",
    "ipv6"
  ],
  "homepage": "https://github.com/yourtion/node-ip2region#readme",
  "bugs": {
    "url": "https://github.com/yourtion/node-ip2region/issues"
  },
  "license": "MIT",
  "author": "Yourtion <yourtion@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourtion/node-ip2region.git"
  },
  "files": [
    "dist",
    "data/README.md",
    "data/manifest.json",
    "docs",
    "CHANGELOG.md",
    "data/ip2region_v4.xdb",
    "data/ip2region_v6.xdb",
    "data/LICENSE.ip2region.md",
    "examples/custom"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./node": {
      "import": {
        "types": "./dist/esm/loaders/node.d.ts",
        "default": "./dist/esm/loaders/node.js"
      },
      "require": {
        "types": "./dist/cjs/loaders/node.d.ts",
        "default": "./dist/cjs/loaders/node.js"
      }
    },
    "./bun": {
      "import": {
        "types": "./dist/esm/loaders/bun.d.ts",
        "default": "./dist/esm/loaders/bun.js"
      }
    },
    "./deno": {
      "import": {
        "types": "./dist/esm/loaders/deno.d.ts",
        "default": "./dist/esm/loaders/deno.js"
      }
    },
    "./formats/ipip-ipdb": {
      "import": {
        "types": "./dist/esm/formats/ipip-ipdb.d.ts",
        "default": "./dist/esm/formats/ipip-ipdb.js"
      },
      "require": {
        "types": "./dist/cjs/formats/ipip-ipdb.d.ts",
        "default": "./dist/cjs/formats/ipip-ipdb.js"
      }
    },
    "./formats/ip2location-bin": {
      "import": {
        "types": "./dist/esm/formats/ip2location-bin.d.ts",
        "default": "./dist/esm/formats/ip2location-bin.js"
      },
      "require": {
        "types": "./dist/cjs/formats/ip2location-bin.d.ts",
        "default": "./dist/cjs/formats/ip2location-bin.js"
      }
    },
    "./formats/ip2region-xdb": {
      "import": {
        "types": "./dist/esm/formats/ip2region-xdb.d.ts",
        "default": "./dist/esm/formats/ip2region-xdb.js"
      },
      "require": {
        "types": "./dist/cjs/formats/ip2region-xdb.d.ts",
        "default": "./dist/cjs/formats/ip2region-xdb.js"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "typecheck": "tsc --noEmit && tsc -p examples/tsconfig.json",
    "test": "npm run build && node --test tests/node.test.mjs tests/reference.test.mjs scripts/npm-release.test.mjs scripts/update-data.test.mjs",
    "prepublishOnly": "npm run check && npm run test:package",
    "test:package": "npm test && node scripts/test-package.mjs",
    "test:packed": "node scripts/test-package.mjs",
    "test:release": "node --test scripts/npm-release.test.mjs",
    "benchmark": "npm run build && node --expose-gc scripts/benchmark.mjs",
    "benchmark:bun": "npm run build && bun scripts/benchmark.mjs",
    "benchmark:deno": "npm run build && deno run --allow-read --allow-sys --v8-flags=--expose-gc scripts/benchmark.mjs",
    "test:examples": "npm run build && node --test examples/custom/custom.test.mjs",
    "benchmark:matrix": "npm run build && node scripts/benchmark-matrix.mjs",
    "data:stage": "npm run build && node scripts/update-data.mjs stage",
    "data:validate": "npm run build && node scripts/update-data.mjs validate",
    "data:apply": "npm run build && node scripts/update-data.mjs apply"
  },
  "devDependencies": {
    "@types/node": "22.5.0",
    "ip2location-nodejs": "9.8.0",
    "ip2region.js": "3.1.8",
    "ipip-ipdb": "0.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.15.9"
}
