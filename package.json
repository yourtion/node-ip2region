{
  "name": "ip2region",
  "version": "2.3.0",
  "description": "Extensible native Node, Bun and Deno IP lookup with bundled ip2region data",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./formats/ip2region": {
      "import": {
        "types": "./dist/esm/formats/ip2region.d.ts",
        "default": "./dist/esm/formats/ip2region.js"
      },
      "require": {
        "types": "./dist/cjs/formats/ip2region.d.ts",
        "default": "./dist/cjs/formats/ip2region.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/loaders/node.d.ts",
        "default": "./dist/esm/loaders/node.js"
      },
      "require": {
        "types": "./dist/cjs/loaders/node.d.ts",
        "default": "./dist/cjs/loaders/node.js"
      }
    },
    "./bun": {
      "import": {
        "types": "./dist/esm/loaders/bun.d.ts",
        "default": "./dist/esm/loaders/bun.js"
      }
    },
    "./deno": {
      "import": {
        "types": "./dist/esm/loaders/deno.d.ts",
        "default": "./dist/esm/loaders/deno.js"
      }
    },
    "./formats/ipip-ipdb": {
      "import": {
        "types": "./dist/esm/formats/ipip-ipdb.d.ts",
        "default": "./dist/esm/formats/ipip-ipdb.js"
      },
      "require": {
        "types": "./dist/cjs/formats/ipip-ipdb.d.ts",
        "default": "./dist/cjs/formats/ipip-ipdb.js"
      }
    },
    "./formats/ip2location-bin": {
      "import": {
        "types": "./dist/esm/formats/ip2location-bin.d.ts",
        "default": "./dist/esm/formats/ip2location-bin.js"
      },
      "require": {
        "types": "./dist/cjs/formats/ip2location-bin.d.ts",
        "default": "./dist/cjs/formats/ip2location-bin.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "data/ip2region.db",
    "data/README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "node scripts/build.mjs",
    "compile": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/node.test.mjs tests/reference.test.mjs",
    "format": "prettier --write src tests scripts docs data/README.md README.md package.json tsconfig.json .github/workflows/test.yml .prettierrc.cjs",
    "prepublishOnly": "npm run test:package",
    "test:package": "npm test && node scripts/test-package.mjs",
    "benchmark": "npm run build && node --expose-gc scripts/benchmark.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourtion/node-ip2region.git"
  },
  "bugs": {
    "url": "https://github.com/yourtion/node-ip2region/issues"
  },
  "homepage": "https://github.com/yourtion/node-ip2region#readme",
  "keywords": [
    "ip",
    "ipv4",
    "ipv6",
    "geoip",
    "ip2region",
    "bun",
    "deno"
  ],
  "author": "Yourtion <yourtion@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.5.0",
    "ip2location-nodejs": "9.8.0",
    "ipip-ipdb": "0.6.0",
    "prettier": "3.3.3",
    "typescript": "5.5.4"
  }
}
