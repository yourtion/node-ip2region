{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/esm",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "declaration": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false
  },
  "include": ["src/index.ts", "src/core/**/*.ts", "src/formats/**/*.ts", "src/loaders/**/*.ts", "src/bundled.ts"]
}
